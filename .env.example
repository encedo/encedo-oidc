# Server
PORT=3000
# production = HSTS header on every response. Any deployment behind TLS should
# run with production; development only turns HSTS off for plain-http localhost.
NODE_ENV=development

# Behind nginx / Caddy / any reverse proxy this MUST be set (1 = one trusted
# hop), otherwise req.ip is the proxy's address: every per-IP rate limit becomes
# one global bucket and ADMIN_ALLOWED_IPS is checked against the proxy. The
# server logs a warning on the first forwarded request it sees without it.
# TRUST_PROXY=1

# Admin API network allow-list: comma-separated IPs / IPv4 CIDRs of the admin
# workstations or VPN (checked against the real client IP -- see TRUST_PROXY).
# Default when unset: localhost only.
# ADMIN_ALLOWED_IPS=127.0.0.1,::1,10.0.0.0/8

# Issuer URL -- must match the URL visible to the RP (e.g. Nextcloud)
# Dev:  http://localhost:3000
# Prod: https://oidc.example.com
ISSUER=http://localhost:3000

# Redis
# Single-instance (systemd): the full URL. redis://:password@host:6379 when
# Redis has requirepass, rediss:// for TLS.
REDIS_URL=redis://127.0.0.1:6379

# Multi-tenant Docker only: tenants/docker-compose.yml starts redis-<tenant>
# with --requirepass and builds REDIS_URL from this value itself (it overrides
# REDIS_URL above), so the password is written exactly once, here.
#   openssl rand -base64 32 | tr -d '/+=' | cut -c1-40
# REDIS_PASSWORD=change-me

# Admin API secret -- change before deploying to production!
ADMIN_SECRET=dev-secret-change-me

# Extra origins for the CSP connect-src (space-separated) -- EPA devices on
# custom domains that the sign-in page must be allowed to call.
# CSP_CONNECT_EXTRA=https://hsm.example.internal

# Size cap of the security:log ZSET (oldest entries trimmed). Default 20000.
# SECURITY_LOG_MAX=20000

# Optional -- credentials of the test RP (rp-server.mjs). Leave RP_CLIENT_SECRET
# empty only if the client is registered as public (PKCE-only) in the admin panel.
# RP_CLIENT_ID=your-client-id-here
# RP_CLIENT_SECRET=your-client-secret-here

# --- Landing page ---------------------------------------------------------
# Set to 1 to serve the product landing page at '/' -- intended for the public
# instance only. The operator status page then lives at '/status' (it is served
# there on every instance). Leave unset on test/demo tenants: '/' keeps showing
# the status page.
# LANDING_PAGE=1

# --- SMTP (email enrollment link) -----------------------------------------
# Optional. The "Email link" feature is disabled unless SMTP_HOST and MAIL_FROM
# are both set. DKIM/SPF/DMARC are handled by the mail server -- the app only
# sends over authenticated TLS. Put the real password in the tenant .env only
# (chmod 600), never in the repo.
# SMTP_HOST=mailserver.example.com
# SMTP_MODE=starttls        # starttls = STARTTLS upgrade (587)  |  ssl = implicit TLS (465)
# SMTP_PORT=587             # optional -- defaults to 587 (starttls) / 465 (ssl)
# SMTP_USER=support@example.com
# SMTP_PASS=change-me       # leave empty if the relay authorises by IP
# MAIL_FROM="Encedo <do-not-reply@example.com>"
